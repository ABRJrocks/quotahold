{
  "name": "quotahold",
  "version": "0.1.0",
  "description": "Durable usage reservations for local Node.js workers, with explicit unknown-call recovery and replay protection.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "quotahold": "src/cli.js"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "tsc --noEmit --strict --module nodenext --target es2022 tests/types.ts",
    "build:site": "node scripts/build-site.js",
    "test:browser": "playwright test",
    "verify:package": "node scripts/verify-package.js",
    "format:check": "prettier --check src tests web scripts examples *.json *.js .github/workflows/*.yml",
    "format": "prettier --write src tests web scripts examples *.json *.js .github/workflows/*.yml"
  },
  "license": "MIT",
  "author": "Abdul Rafay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABRJrocks/quotahold.git"
  },
  "homepage": "https://abrjrocks.github.io/quotahold/",
  "bugs": {
    "url": "https://github.com/ABRJrocks/quotahold/issues"
  },
  "keywords": [
    "quota",
    "llm",
    "budget",
    "sqlite",
    "idempotency"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
